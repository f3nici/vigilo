# Copy to .env before the first run. docker compose reads it automatically.

# Which published build to run. `latest` follows the default branch; pin a
# release tag on anything you care about, so an upgrade is something you do on
# purpose rather than something a restart does for you.
TAG=latest
IMAGE_PREFIX=docker.io/f3nici/vigilo

POSTGRES_USER=vigilo
POSTGRES_PASSWORD=vigilo
POSTGRES_DB=vigilo

# The API serves as this restricted role, which has no UPDATE or DELETE on the
# audit log. Migrations run as POSTGRES_USER above.
APP_DB_ROLE=vigilo_app
APP_DB_PASSWORD=vigilo_app_dev

# REQUIRED. Wraps the per-table data keys, so losing it loses the data.
# Generate with:  openssl rand -base64 32
# Keep a documented, separate, offline backup of it (doc 07 §6).
# Rotation: MASTER_KEY=1:<old base64>,2:<new base64> and keep the old version
# until the re-encryption job has worked through every row.
MASTER_KEY=

WEB_PORT=8081
LOG_LEVEL=info
BUILD_HASH=local

# The organisation's timezone, as an IANA name. Every window, every dose and
# every "daily" calculation is decided in it, and it is the only zone staff
# ever see. Applied when the settings row has never been edited, so it sets up
# a fresh deployment and then stops overruling the product.
ORG_TIMEZONE=Australia/Perth

# The Capacitor app signs in from https://localhost. Keep it in the list, and
# set SESSION_SAMESITE=none once the native builds exist, or native sign-in
# fails silently.
CORS_ORIGINS=http://localhost:8081,https://localhost
SESSION_SAMESITE=lax

# No TLS in front of the local stack. Production terminates TLS and sets this
# back to true.
SESSION_COOKIE_SECURE=false

# Where attachment bytes live inside the API container. A named volume locally,
# an encrypted volume in production. Each file is encrypted again under its own
# key, so this is defence in depth rather than the only protection.
ATTACHMENT_DIR=/data/attachments
