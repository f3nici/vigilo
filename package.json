{
  "name": "vigilo",
  "version": "0.3.0",
  "private": true,
  "description": "Care records platform for a disability support team",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/app"
  ],
  "scripts": {
    "build": "npm run build --workspace @vigilo/shared && npm run build --workspace @vigilo/api && npm run build --workspace @vigilo/app",
    "typecheck": "npm run build --workspace @vigilo/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace @vigilo/shared && npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace @vigilo/api",
    "dev:app": "npm run dev --workspace @vigilo/app"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true,
    "argon2@0.45.1": true
  }
}
